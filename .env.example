# ==============================================================================
# Odonto Excellence Canela - Variáveis de Ambiente
# Cadastre estas variáveis no painel da Vercel:
# Settings > Environment Variables (Environment: Production e Preview)
# ==============================================================================

# Chave de API do Resend (obter em https://resend.com/api-keys)
# Obrigatória para o envio real dos e-mails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# E-mail de destino que receberá todos os formulários preenchidos no site
CONTACT_EMAIL_TO=odontoexcellence.canela@gmail.com

# Remetente do e-mail:
# - Durante fase inicial/testes: "Odonto Excellence <onboarding@resend.dev>"
# - Após verificar o domínio no Resend: "Odonto Excellence <site@odontoexcellencecanela.com.br>"
EMAIL_FROM=onboarding@resend.dev

# URL oficial e canônica do site (sem barra no final)
SITE_URL=https://odontoexcellencecanela.com.br

# Lista de origens autorizadas para requisições na API (separadas por vírgula)
ALLOWED_ORIGINS=odonto-excellence-canela.vercel.app,odontoexcellencecanela.com.br,www.odontoexcellencecanela.com.br,localhost:3000
