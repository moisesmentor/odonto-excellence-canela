# Odonto Excellence Canela - Apache / cPanel .htaccess
# Configurações de SEO, URLs Amigáveis e Compressão

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redireciona index.html para a raiz /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # Se a pasta com index.html existir, serve ela
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Remove extensão .html da URL
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/
  RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

  # Serve arquivo .html se existir
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# Página de erro 404 personalizada
ErrorDocument 404 /404.html

# Compressão Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caching de arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
